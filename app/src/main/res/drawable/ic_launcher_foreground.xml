<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled centered Crescent Moon -->
    <path
        android:pathData="M68,34 C52,32 37,42 33,58 C29,74 39,88 55,90 C46,87 38,79 38,67 C38,50 53,38 68,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="32"
                android:endX="70"
                android:endY="90"
                android:type="linear">
                <item android:color="#F8FAFC" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.5" />
                <item android:color="#818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sound waves forming 'M' -->
    <path
        android:pathData="M48,52 L48,72"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,44 L54,78"
        android:strokeWidth="2.5"
        android:strokeColor="#06B6D4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M60,54 L60,70"
        android:strokeWidth="2.5"
        android:strokeColor="#818CF8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M66,46 L66,76"
        android:strokeWidth="2.5"
        android:strokeColor="#A855F7"
        android:strokeLineCap="round" />

    <path
        android:pathData="M72,55 L72,69"
        android:strokeWidth="2.5"
        android:strokeColor="#EC4899"
        android:strokeLineCap="round" />

    <!-- Radiant Starlet -->
    <path
        android:pathData="M74,38m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0"
        android:fillColor="#F8FAFC" />
</vector>
